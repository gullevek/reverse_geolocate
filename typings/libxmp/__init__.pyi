"""
Type stubs for libxmp (python-xmp-toolkit 2.1.0)

python-xmp-toolkit ships no type information (no .pyi / py.typed) and there is
no types-* package on PyPI or in typeshed, so these are maintained locally.
Signatures follow libxmp/core.py of the 2.1.0 release.
"""

import datetime
from collections.abc import Iterator
from typing import Any, override

from . import consts as consts

__version__: str

__all__ = ["ExempiLoadError", "XMPError", "XMPFiles", "XMPMeta", "consts"]

class ExempiLoadError(Exception):
    """Error signaling that the Exempi library cannot be loaded."""

class XMPError(Exception):
    """General XMP Error."""

class XMPMeta:
    """XMPMeta is the class providing the core services of the library"""

    def __init__(self, *, xmp_str: str = ..., _xmp_internal_ref: Any = ...) -> None: ...
    def __iter__(self) -> XMPIterator: ...
    @override
    def __eq__(self, other: object) -> bool: ...
    @override
    def __ne__(self, other: object) -> bool: ...
    # getters
    def get_property(self, schema_ns: str, prop_name: str) -> str: ...
    def get_array_item(self, schema_ns: str, array_prop_name: str, index: int) -> str: ...
    def get_property_bool(self, schema: str, name: str) -> bool: ...
    def get_property_int(self, schema_ns: str, name: str) -> int: ...
    def get_property_long(self, schema_ns: str, prop_name: str) -> int: ...
    def get_property_float(self, schema_ns: str, prop_name: str) -> float: ...
    def get_property_datetime(self, schema_ns: str, prop_name: str) -> datetime.datetime: ...
    def get_localized_text(self, schema_ns: str, alt_text_name: str, generic_lang: str, specific_lang: str) -> str: ...
    # setters, **kwargs are option flags from consts.XMP_PROP_OPTIONS
    def set_property(self, schema_ns: str, prop_name: str, prop_value: str, **kwargs: bool) -> None: ...
    def set_array_item(
        self, schema_ns: str, array_name: str, item_index: int, item_value: str, **kwargs: bool
    ) -> None: ...
    def append_array_item(
        self,
        schema_ns: str,
        array_name: str,
        item_value: str,
        array_options: dict[str, bool] | None = None,
        **kwargs: bool,
    ) -> None: ...
    def set_property_bool(self, schema_ns: str, prop_name: str, prop_value: bool, **kwargs: bool) -> None: ...
    def set_property_int(self, schema_ns: str, prop_name: str, prop_value: int, **kwargs: bool) -> None: ...
    def set_property_long(self, schema_ns: str, prop_name: str, prop_value: int, **kwargs: bool) -> None: ...
    def set_property_float(self, schema_ns: str, prop_name: str, prop_value: float, **kwargs: bool) -> None: ...
    def set_property_datetime(
        self, schema_ns: str, prop_name: str, prop_value: datetime.datetime, **kwargs: bool
    ) -> None: ...
    def set_localized_text(
        self,
        schema_ns: str,
        alt_text_name: str,
        generic_lang: str,
        specific_lang: str,
        prop_value: str,
        **kwargs: bool,
    ) -> None: ...
    # delete / exists
    def delete_localized_text(
        self, schema_ns: str, alt_text_name: str, generic_lang: str, specific_lang: str
    ) -> None: ...
    def delete_property(self, schema_ns: str, prop_name: str) -> None: ...
    def does_property_exist(self, schema_ns: str, prop_name: str) -> bool: ...
    def does_array_item_exist(self, schema_ns: str, array_name: str, item: str) -> bool: ...
    def count_array_items(self, schema_ns: str, array_name: str) -> int: ...
    # parse / serialize, **kwargs are option flags from consts.XMP_SERIAL_OPTIONS
    def parse_from_str(
        self, xmp_packet_str: str, xmpmeta_wrap: bool = False, input_encoding: str | None = None
    ) -> None: ...
    def serialize_and_format(
        self, padding: int = 0, newlinechr: str = "\n", tabchr: str = "\t", indent: int = 0, **kwargs: bool
    ) -> str: ...
    def serialize_to_unicode(self, **kwargs: bool) -> str: ...
    def serialize_to_str(self, padding: int = 0, **kwargs: bool) -> str: ...
    def clone(self) -> XMPMeta | None: ...
    # namespaces
    @staticmethod
    def get_prefix_for_namespace(namespace: str) -> str: ...
    @staticmethod
    def get_namespace_for_prefix(prefix: str) -> str: ...
    @staticmethod
    def register_namespace(namespace_uri: str, suggested_prefix: str) -> str: ...

class XMPIterator(Iterator[tuple[str, str, str, dict[str, bool]]]):
    """Iterates over schema and properties: yields (schema, name, value, options)"""

    def __init__(
        self, xmp_obj: XMPMeta, schema_ns: str | None = None, prop_name: str | None = None, **kwargs: bool
    ) -> None: ...
    @override
    def __iter__(self) -> XMPIterator: ...
    @override
    def __next__(self) -> tuple[str, str, str, dict[str, bool]]: ...
    def next(self) -> tuple[str, str, str, dict[str, bool]]: ...
    def skip(self, **kwargs: bool) -> None: ...

class XMPFiles:
    """Low level file access (does not work with sidecar .xmp files)"""

    def __init__(self, **kwargs: Any) -> None: ...
    def open_file(self, file_path: str, **kwargs: bool) -> None: ...
    def close_file(self, close_flags: int = ...) -> None: ...
    def get_xmp(self) -> XMPMeta | None: ...
    def put_xmp(self, xmp_obj: XMPMeta) -> None: ...
    def can_put_xmp(self, xmp_obj: XMPMeta) -> bool: ...
