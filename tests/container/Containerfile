# Test container: runs the full test suite with the Exempi library installed
# (the integration tests need Exempi, they are not collected without it)
#
# build and run with: make test-container
# works with docker or podman, the build context is the repository root:
#   docker build -f tests/container/Containerfile -t reverse-geolocate-test .
#   docker run --rm reverse-geolocate-test [pytest arguments]

FROM python:3.14-slim-trixie

# Exempi (XMP library, loaded by python-xmp-toolkit via ctypes)
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libexempi8 \
    && rm -rf /var/lib/apt/lists/*

# uv, same minor version as used for development
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /usr/local/bin/uv

# own virtual environment outside of the project folder, use the image Python only
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

# not root: the file permission tests are skipped for root
RUN useradd --create-home tester \
    && mkdir /work /opt/venv \
    && chown tester:tester /work /opt/venv
USER tester
WORKDIR /work

# dependencies first, so this layer is cached as long as the lock file does not change
COPY --chown=tester:tester pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project

# project and tests
COPY --chown=tester:tester . .
RUN uv sync --frozen

ENTRYPOINT ["uv", "run", "--frozen", "--no-sync", "pytest"]
CMD []
